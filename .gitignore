# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Secrets
.env
*.env

# Local server logs
uvlog.txt
uvout.txt

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Extraction outputs (generated, not committed)
output/
wiring_data/
*.tar.gz

# Vector search index (generated from the manual; rebuildable, per vehicle)
vehicles/*/.index/

# Bulk diagram sets are large and regenerable via build_vehicle.py, so batch-
# extracted vehicles keep diagrams local-only. The two flagship vehicles
# (grand-marquis, mark-viii) were committed before this rule and stay tracked
# (ignore doesn't untrack); their diagrams are the committed examples.
vehicles/*/diagrams/

# Proprietary OEM source archives (extract from media you own; never commit)
*.ARC
*.arc
*.MDB
*.mdb
*.ova
*.vmdk
*.iso

# Large data files that should use Git LFS or be downloaded separately
# Uncomment these if the vehicle data is too large for your repo:
# vehicles/*/references/workshop_manual.txt
# vehicles/*/references/owners_manual.txt
